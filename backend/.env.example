APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./app.db
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Binance Production (leave empty to auto-enable Testnet)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_REQUEST_TIMEOUT=10.0

# Binance Testnet/Sandbox (set BINANCE_TESTNET=true to force testnet)
BINANCE_TESTNET=false

# Binance Sub-Account API (Master account API key with sub-account permissions)
BINANCE_SUB_ACCOUNT_API_KEY=
BINANCE_SUB_ACCOUNT_API_SECRET=
